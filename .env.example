PORT=3000

# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Model id to call through OpenRouter, e.g. typesafe/jev-router or typesafe/jev-1.13
JEV_MODEL=typesafe/jev-router

# Set to "true" to skip the real Jev call and return a randomized mock
# classification instead, so the UI can be built/demoed without an API key.
USE_MOCK_JEV=true
